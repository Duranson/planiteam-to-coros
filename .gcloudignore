# Files excluded from the Cloud Function deployment bundle.
# Critically: .env / recipients.json hold real secrets and must never be
# uploaded - the deployed function gets credentials via --set-secrets instead.
.env
recipients.json
.venv/
__pycache__/
*.pyc
.git/
.gitignore
.github/
tests/
example/
CLAUDE.md
DEPLOYMENT.md
README.md
apps_script/
manage_recipients.py
